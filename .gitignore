# --- Java / Maven ---
*.class
*.log
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
target/
!**/.mvn/wrapper/maven-wrapper.jar

# --- Node / Vite ---
node_modules/
dist/
dist-ssr/
coverage/
*.local
npm-debug.log*

# --- Caches de herramientas (tsc, eslint, vite) ---
*.tsbuildinfo
.eslintcache
.vite/

# --- Tests de navegador / Playwright / DevTools (salidas locales) ---
.playwright/
.playwright-mcp/
playwright-report/
playwright/.cache/
test-results/
blob-report/
*.heapsnapshot
*.cpuprofile
*.trace

# --- Temporales ---
tmp/
.tmp/
*.tmp
*.swp

# --- Vercel ---
.vercel/

# --- Entorno / secretos ---
.env
.env.*
!.env.example

# --- IDEs / SO ---
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# --- Agentes, skills y herramientas (locales, no se versionan) ---
# De .claude/ solo se versiona lo compartido: settings.json, agents/ y rules/.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/rules/
CLAUDE.local.md
.superpowers/
docs/superpowers/
.agents/
.codex/
.cursor/
.serena/
.remember/
.caveman/
.ponytail/
.ecc/
.codebase-index/

# --- Archivos pesados o de trabajo (van a Drive, no al repo) ---
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.xls
*.xlsx
*.zip
*.rar
*.7z
*.mp4
*.mov
*.psd
*.fig
~$*
