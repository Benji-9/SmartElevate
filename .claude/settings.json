{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw verify:*)",
      "Bash(./mvnw test:*)",
      "Bash(./mvnw -B verify:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run format:*)",
      "Bash(npm test:*)",
      "Bash(npm ci)",
      "Bash(actionlint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Read(**/.env)",
      "Read(**/.env.local)"
    ]
  }
}
