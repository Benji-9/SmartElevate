{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw verify:*)",
      "Bash(./mvnw -B verify:*)",
      "Bash(./mvnw test:*)",
      "Bash(./mvnw spring-boot:run:*)",
      "Bash(npm ci)",
      "Bash(npm install:*)",
      "Bash(npm ls:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run format:*)",
      "Bash(npm run gen:api:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(actionlint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr merge --auto:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr status:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh label list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh auth status:*)",
      "PowerShell(.\\mvnw:*)",
      "PowerShell(npm ci)",
      "PowerShell(npm install:*)",
      "PowerShell(npm test:*)",
      "PowerShell(npm run:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(gh pr create:*)",
      "PowerShell(gh pr merge --auto:*)",
      "PowerShell(gh pr view:*)",
      "PowerShell(gh pr checks:*)"
    ],
    "ask": [
      "Bash(gh issue create:*)",
      "Bash(gh release create:*)",
      "Bash(gh label create:*)",
      "Bash(gh label delete:*)",
      "Bash(gh api:*)",
      "Bash(git tag:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(cat .env:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin develop:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin HEAD:develop:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release delete:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push origin main:*)",
      "PowerShell(git push origin develop:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(Remove-Item -Recurse:*)",
      "PowerShell(gh repo delete:*)",
      "PowerShell(gh release delete:*)"
    ]
  }
}
