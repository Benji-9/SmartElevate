# URL base de la API.
# - Dev: dejala en /api (el proxy de Vite la manda a http://localhost:8080).
# - Vercel: /api (el rewrite de vercel.json la manda al backend) o la URL absoluta del backend.
VITE_API_URL=/api

# Datos simulados (src/services/mocks.ts) para desarrollar sin backend.
# Por defecto prendidos en `npm run dev`; nunca entran al build de producción.
# Poné false para pegarle al backend local en todos los endpoints.
# VITE_USE_MOCKS=false
