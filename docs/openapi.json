{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Reserva de turnos de ascensores para reducir la congestión en el campus",
    "title" : "SmartElevate API",
    "version" : "v0"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Mismo origen"
  } ],
  "tags" : [ {
    "description" : "Alta de cuentas y sesión (login, refresh, logout)",
    "name" : "auth"
  }, {
    "description" : "Verificación de conectividad",
    "name" : "ping"
  }, {
    "description" : "Edificios, núcleos y ascensores (solo lectura)",
    "name" : "elevator"
  }, {
    "description" : "Salidas de ascensor y turnos",
    "name" : "turn"
  } ],
  "paths" : {
    "/api/auth/login" : {
      "post" : {
        "description" : "Las credenciales incorrectas dan 401 sin distinguir si el email existe. Con la clave correcta pero el email sin verificar responde 403.",
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Bad Request"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Email o contraseña incorrectos"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "El email institucional todavía no se verificó"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Internal Server Error"
          }
        },
        "summary" : "Inicia sesión y devuelve access y refresh token",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/logout" : {
      "post" : {
        "description" : "Idempotente: un token desconocido tampoco da error.",
        "operationId" : "logout",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Bad Request"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Internal Server Error"
          }
        },
        "summary" : "Cierra la sesión revocando el refresh token",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/password/forgot" : {
      "post" : {
        "description" : "Responde 202 exista o no la cuenta (y haya o no un pedido reciente), para no revelar qué emails están registrados. Un pedido nuevo invalida el link anterior.",
        "operationId" : "forgotPassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ForgotPasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Bad Request"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Internal Server Error"
          }
        },
        "summary" : "Pide el link para restablecer la contraseña",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/password/reset" : {
      "post" : {
        "description" : "El token sirve una sola vez y vence. Cambia la contraseña y revoca todos los refresh tokens del usuario (se cierran todas sus sesiones).",
        "operationId" : "resetPassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ResetPasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Token inválido, usado o vencido, o contraseña fuera de política"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Internal Server Error"
          }
        },
        "summary" : "Elige una contraseña nueva con el token del link",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/refresh" : {
      "post" : {
        "description" : "El refresh token es de un solo uso: si uno ya canjeado se vuelve a presentar, se revoca toda la sesión.",
        "operationId" : "refresh",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Bad Request"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Refresh token inválido, vencido, revocado o ya usado"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Internal Server Error"
          }
        },
        "summary" : "Canjea un refresh token por un par nuevo (rotación)",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/register" : {
      "post" : {
        "description" : "El rol y la prioridad no se piden ni se aceptan: todo usuario nace común. Si el email o el legajo ya tienen cuenta, responde 409 con el campo que chocó.",
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Bad Request"
          },
          "409" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "El email o el legajo ya tienen cuenta"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Internal Server Error"
          }
        },
        "summary" : "Crea una cuenta común, sin verificar",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/resend-verification" : {
      "post" : {
        "description" : "Responde 202 exista o no la cuenta, para no revelar qué emails están registrados. Si ya se mandó uno hace poco responde 429 con el header Retry-After.",
        "operationId" : "resendVerification",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ResendVerificationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Bad Request"
          },
          "429" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Ya se mandó un mail hace poco"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Internal Server Error"
          }
        },
        "summary" : "Reenvía el link de verificación",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/verify" : {
      "post" : {
        "description" : "El token sirve una sola vez y vence. Si no existe, ya se usó o venció, responde 400 con el motivo en el mensaje. Es POST (y no GET) para que los antivirus de los mails que abren los links no gasten el token.",
        "operationId" : "verify",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/VerifyEmailRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Token inválido, usado o vencido"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Internal Server Error"
          }
        },
        "summary" : "Verifica el email con el token del link",
        "tags" : [ "auth" ]
      }
    },
    "/api/buildings" : {
      "get" : {
        "operationId" : "buildings",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/BuildingResponse"
                  }
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Bad Request"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Internal Server Error"
          }
        },
        "summary" : "Lista los edificios con su rango de pisos y sus núcleos",
        "tags" : [ "elevator" ]
      }
    },
    "/api/departures" : {
      "get" : {
        "description" : "Excluye los ascensores dedicados. Genera las salidas que falten de forma idempotente.",
        "operationId" : "bookable",
        "parameters" : [ {
          "description" : "Código del ascensor",
          "example" : 33,
          "in" : "query",
          "name" : "elevator",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Código del edificio, sin distinguir mayúsculas",
          "example" : "INDEPENDENCIA",
          "in" : "query",
          "name" : "building",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/DepartureResponse"
                  }
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Bad Request"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Internal Server Error"
          }
        },
        "summary" : "Lista las salidas reservables ahora (ventana de reserva) con su cupo restante",
        "tags" : [ "turn" ]
      }
    },
    "/api/elevators" : {
      "get" : {
        "operationId" : "elevators",
        "parameters" : [ {
          "description" : "Código del edificio, sin distinguir mayúsculas",
          "example" : "INDEPENDENCIA",
          "in" : "query",
          "name" : "building",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Solo los ascensores que paran en este piso (0 = PB)",
          "example" : 11,
          "in" : "query",
          "name" : "floor",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ElevatorResponse"
                  }
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Bad Request"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Internal Server Error"
          }
        },
        "summary" : "Lista los ascensores activos con los pisos donde paran",
        "tags" : [ "elevator" ]
      }
    },
    "/api/ping" : {
      "get" : {
        "operationId" : "ping",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PingResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Bad Request"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            },
            "description" : "Internal Server Error"
          }
        },
        "summary" : "Verifica que la API responde",
        "tags" : [ "ping" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ApiError" : {
        "type" : "object",
        "description" : "Error estándar de la API",
        "properties" : {
          "error" : {
            "type" : "string",
            "example" : "Not Found"
          },
          "message" : {
            "type" : "string",
            "example" : "Recurso no encontrado"
          },
          "path" : {
            "type" : "string",
            "example" : "/api/turns/42"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 404
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          },
          "violations" : {
            "type" : "array",
            "description" : "Solo en errores de validación",
            "items" : {
              "$ref" : "#/components/schemas/FieldViolation"
            }
          }
        },
        "required" : [ "error", "message", "path", "status", "timestamp" ]
      },
      "BuildingResponse" : {
        "type" : "object",
        "description" : "Edificio con su rango de pisos y sus núcleos",
        "properties" : {
          "code" : {
            "type" : "string",
            "example" : "LIMA"
          },
          "cores" : {
            "type" : "array",
            "description" : "Núcleos del edificio, ordenados por código",
            "items" : {
              "$ref" : "#/components/schemas/CoreResponse"
            }
          },
          "maxFloor" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 10
          },
          "minFloor" : {
            "type" : "integer",
            "format" : "int32",
            "example" : -4
          },
          "name" : {
            "type" : "string",
            "example" : "Lima"
          }
        },
        "required" : [ "code", "cores", "maxFloor", "minFloor", "name" ]
      },
      "CoreResponse" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "example" : "L3"
          },
          "name" : {
            "type" : "string",
            "example" : "Lima 3"
          }
        },
        "required" : [ "code", "name" ]
      },
      "DepartureResponse" : {
        "type" : "object",
        "description" : "Salida de un ascensor reservable ahora, con su cupo restante",
        "properties" : {
          "building" : {
            "type" : "string",
            "example" : "INDEPENDENCIA"
          },
          "capacity" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 10
          },
          "departureAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Hora estimada de salida, en UTC",
            "example" : "2026-10-13T15:56:00Z"
          },
          "elevator" : {
            "type" : "string",
            "example" : "33"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64",
            "example" : 1234
          },
          "remainingSeats" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Lugares libres",
            "example" : 10
          },
          "status" : {
            "type" : "string",
            "enum" : [ "SCHEDULED", "CANCELLED" ]
          }
        },
        "required" : [ "building", "capacity", "departureAt", "elevator", "id", "remainingSeats", "status" ]
      },
      "ElevatorResponse" : {
        "type" : "object",
        "description" : "Ascensor con los pisos donde para",
        "properties" : {
          "active" : {
            "type" : "boolean"
          },
          "building" : {
            "type" : "string",
            "example" : "INDEPENDENCIA"
          },
          "code" : {
            "type" : "string",
            "example" : "33"
          },
          "core" : {
            "type" : "string",
            "example" : "IND2"
          },
          "coreName" : {
            "type" : "string",
            "example" : "Independencia 2"
          },
          "floors" : {
            "type" : "array",
            "description" : "Pisos servidos, de menor a mayor (0 = PB)",
            "example" : [ -4, -3, -2, -1, 0, 2, 3 ],
            "items" : {
              "type" : "integer",
              "format" : "int32"
            }
          },
          "usage" : {
            "type" : "string",
            "description" : "COMMON, o dedicado a docentes (TEACHERS) o a movilidad reducida (REDUCED_MOBILITY)",
            "enum" : [ "COMMON", "TEACHERS", "REDUCED_MOBILITY" ]
          }
        },
        "required" : [ "active", "building", "code", "core", "coreName", "floors", "usage" ]
      },
      "FieldViolation" : {
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "field", "message" ]
      },
      "ForgotPasswordRequest" : {
        "type" : "object",
        "description" : "Cuenta que olvidó su contraseña",
        "properties" : {
          "email" : {
            "type" : "string",
            "example" : "jmartinez@uade.edu.ar",
            "minLength" : 1
          }
        },
        "required" : [ "email" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "description" : "Credenciales de inicio de sesión",
        "properties" : {
          "email" : {
            "type" : "string",
            "example" : "jmartinez@uade.edu.ar",
            "minLength" : 1
          },
          "password" : {
            "type" : "string",
            "format" : "password",
            "example" : "una-clave-larga",
            "minLength" : 1
          }
        },
        "required" : [ "email", "password" ]
      },
      "PingResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "example" : "ok"
          }
        },
        "required" : [ "status" ]
      },
      "RefreshRequest" : {
        "type" : "object",
        "description" : "Refresh token vigente de la sesión",
        "properties" : {
          "refreshToken" : {
            "type" : "string",
            "example" : "b0Yq3k...",
            "minLength" : 1
          }
        },
        "required" : [ "refreshToken" ]
      },
      "RegisterRequest" : {
        "type" : "object",
        "description" : "Datos para crear una cuenta. No lleva rol ni prioridad: todo usuario nace común",
        "properties" : {
          "declaredUserType" : {
            "type" : "string",
            "description" : "Lo que la persona declara ser. Es informativo: no da rol ni prioridad",
            "enum" : [ "STUDENT", "TEACHER" ]
          },
          "email" : {
            "type" : "string",
            "description" : "Email institucional. Se guarda en minúsculas",
            "example" : "jmartinez@uade.edu.ar",
            "pattern" : "[A-Za-z0-9._%+-]{1,64}@uade\\.edu\\.ar"
          },
          "fullName" : {
            "type" : "string",
            "example" : "Juana Martínez",
            "maxLength" : 100,
            "minLength" : 0
          },
          "legajo" : {
            "type" : "string",
            "example" : "1234567",
